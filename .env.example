# Backend (Supabase is open source and can be self-hosted)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# OAuth client IDs generated by Firebase/Google Cloud. Android is read from
# google-services.json; iOS and web can be supplied here for browser OAuth.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# OpenFreeMap: MIT project, free commercial public map display with OSM attribution.
# Replace with your own OpenFreeMap server to self-host. No API key required.
EXPO_PUBLIC_OPENFREEMAP_BASE_URL=https://tiles.openfreemap.org
# Offline downloads require a raster server whose terms explicitly allow bulk/offline use.
# Leave empty unless configured; public tile.openstreetmap.org must not be used here.
EXPO_PUBLIC_OFFLINE_TILE_URL=
# Existing providers remain optional and have their own service terms.
EXPO_PUBLIC_MAPLIBRE_STYLE_URL=
EXPO_PUBLIC_MAPLIBRE_DEM_URL=https://tiles.mapterhorn.com/tilejson.json
# Cloudflare Worker public URL only. Provider credentials must never enter Expo config.
EXPO_PUBLIC_ROUTING_GATEWAY_URL=
# Optional terrain asset configured privately on the Worker.
EXPO_PUBLIC_CESIUM_TERRAIN_ENABLED=false
EXPO_PUBLIC_ROUTING_PROVIDERS=osrm,valhalla,graphhopper
EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org
EXPO_PUBLIC_VALHALLA_URL=https://valhalla1.openstreetmap.de

# OpenStreetMap endpoints. Search is submit-only (no autocomplete) and cached.
EXPO_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_OSM_SEARCH_URL=https://nominatim.openstreetmap.org/search
EXPO_PUBLIC_OSM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
EXPO_PUBLIC_OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Public AdMob defaults also live in config/admob.json; non-empty values override them.
# Android and Amazon share IDs; iOS uses its own native unit. Blank banner IDs disable banners.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-9161074667002246~7998118867
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-9161074667002246~3833345863
EXPO_PUBLIC_AMAZON_APS_APP_ID=
EXPO_PUBLIC_ADMOB_NATIVE_SMART_ID=ca-app-pub-9161074667002246/5866779544
EXPO_PUBLIC_ADMOB_NATIVE_FRIENDS_ID=ca-app-pub-9161074667002246/5866779544
EXPO_PUBLIC_ADMOB_NATIVE_TIMELINE_ID=ca-app-pub-9161074667002246/5866779544
EXPO_PUBLIC_ADMOB_NATIVE_STATS_ID=ca-app-pub-9161074667002246/5866779544
EXPO_PUBLIC_ADMOB_NATIVE_PROFILE_ID=ca-app-pub-9161074667002246/5866779544
EXPO_PUBLIC_ADMOB_NATIVE_MEMORIES_ID=ca-app-pub-9161074667002246/5866779544
EXPO_PUBLIC_ADMOB_NATIVE_HEATMAP_ID=ca-app-pub-9161074667002246/5866779544
EXPO_PUBLIC_ADMOB_NATIVE_SETTINGS_ID=ca-app-pub-9161074667002246/5866779544
EXPO_PUBLIC_ADMOB_NATIVE_PLACE_ID=ca-app-pub-9161074667002246/5866779544
EXPO_PUBLIC_ADMOB_BANNER_SMART_ID=
EXPO_PUBLIC_ADMOB_BANNER_FRIENDS_ID=
EXPO_PUBLIC_ADMOB_BANNER_TIMELINE_ID=
EXPO_PUBLIC_ADMOB_BANNER_STATS_ID=
EXPO_PUBLIC_ADMOB_BANNER_PROFILE_ID=
EXPO_PUBLIC_ADMOB_BANNER_MEMORIES_ID=
EXPO_PUBLIC_ADMOB_BANNER_HEATMAP_ID=
EXPO_PUBLIC_ADMOB_BANNER_SETTINGS_ID=
EXPO_PUBLIC_ADMOB_BANNER_PLACE_ID=

# Set to true only when intentionally previewing Google test ads.
EXPO_PUBLIC_ENABLE_TEST_ADS=false

EXPO_PUBLIC_SPOTIFY_CLIENT_ID=803c9a3953f045e8822fa05d271a0fd0
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=https://mymap.html-5.me/?i=1

# Optional map extensions; all layers are off by default.
EXPO_PUBLIC_VIETFUEL_URL=https://vietfuel-api.tranqui.workers.dev

# Three-store release configuration; no private values here.
EAS_PROJECT_ID=
GOOGLE_IOS_REVERSED_CLIENT_ID=
EXPO_PUBLIC_EMAIL_LINK_DOMAIN=
EXPO_PUBLIC_EMAIL_LINK_CONTINUE_URL=
MYMAP_ENABLE_WIDGETS=true
MYMAP_ENABLE_WATCH=true
MYMAP_ENABLE_CARPLAY=false
EXPO_PUBLIC_ADMOB_IOS_NATIVE_SMART_ID=ca-app-pub-9161074667002246/9233846353
