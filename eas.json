{
  "cli": {
    "version": "24.7.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "autoIncrement": false,
      "environment": "production",
      "node": "24.14.0",
      "env": {
        "MYMAP_RELEASE": "true",
        "EXPO_PUBLIC_ENABLE_TEST_ADS": "false",
        "RNLLAMA_SKIP_POSTINSTALL": "1"
      }
    },
    "ios-store": {
      "extends": "base",
      "distribution": "store",
      "env": {
        "MYMAP_STORE": "ios",
        "APP_STORE_TARGET": "ios"
      },
      "ios": {
        "buildConfiguration": "Release",
        "image": "macos-tahoe-26.5-xcode-26.6"
      }
    },
    "android-play": {
      "extends": "base",
      "distribution": "store",
      "env": {
        "MYMAP_STORE": "play",
        "APP_STORE_TARGET": "play"
      },
      "android": {
        "gradleCommand": ":app:bundleGoogleRelease",
        "credentialsSource": "local",
        "buildType": "app-bundle"
      }
    },
    "android-apk": {
      "extends": "android-play",
      "android": {
        "gradleCommand": ":app:assembleGoogleRelease",
        "buildType": "apk"
      }
    },
    "android-amazon": {
      "extends": "base",
      "distribution": "store",
      "env": {
        "MYMAP_STORE": "amazon",
        "APP_STORE_TARGET": "amazon"
      },
      "android": {
        "gradleCommand": ":app:assembleAmazonRelease",
        "credentialsSource": "local",
        "buildType": "apk"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "MYMAP_RELEASE": "false",
        "MYMAP_STORE": "development",
        "RNLLAMA_SKIP_POSTINSTALL": "1",
        "APP_STORE_TARGET": "development"
      }
    },
    "ios-unsigned": {
      "extends": "ios-store",
      "withoutCredentials": true,
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "config": "ios-unsigned.yml",
        "buildConfiguration": "Release"
      }
    }
  }
}
