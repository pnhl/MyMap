<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="androidx.car.app.ACCESS_SURFACE"/>
 <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES"/>
 <application>
  <service android:name=".MyMapWearSOSService" android:exported="true">
   <intent-filter><action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED"/><data android:scheme="wear" android:host="*" android:path="/mymap/sos"/></intent-filter>
  </service>
  <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc"/>
  <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1"/>
  <service android:name=".MyMapCarService" android:exported="true">
   <intent-filter><action android:name="androidx.car.app.CarAppService"/><category android:name="androidx.car.app.category.NAVIGATION"/></intent-filter>
  </service>
 </application>
</manifest>
